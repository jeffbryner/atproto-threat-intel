{
    "display_information": {
        "name": "Threat-Intel",
        "description": "Threat intelligence network formembers.",
        "background_color": "#1d1d1d"
    },
    "features": {
        "bot_user": {
            "display_name": "Threat-Intel Bot",
            "always_online": false
        }
    },
    "oauth_config": {
        "redirect_urls": [
            "http://localhost:8000/v1/auth/callback"
        ],
        "scopes": {
            "bot": [
                "team:read",
                "users:read",
                "users:read.email"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false
    }
}